# Copy to .env.local. Use the project's PUBLIC publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# These public values are delivered from server runtime to the browser. Restart after editing.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_SURFACE=pwa

# Public contact shown on /about. Set your real details before inviting testers.
PETFOLIO_OPERATOR_NAME=
PETFOLIO_SUPPORT_EMAIL=
